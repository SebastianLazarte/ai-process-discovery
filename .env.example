# Database. SQLite by default; PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://apd:apd@localhost:5432/apd
DATABASE_URL=sqlite:///./apd.sqlite

# LLM provider: "fake" (default, deterministic, no key) or "anthropic"
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# Leave empty to use the default model defined in app/core/config.py
ANTHROPIC_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Analyses per UTC day that may call the LLM; no limit when unset
# LLM_DAILY_LIMIT=50

# Embeddings for retrieval over the sector catalog: "fake" (default, deterministic, no key)
# or "voyage" (arrives with RS-120)
EMBEDDING_PROVIDER=fake
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

LOG_LEVEL=INFO

# Public deployment: the web client shows a banner that data is public and short-lived
PUBLIC_DEMO=false
# AI drafts of a process from a description; stays off until RS-100 and RS-101 merge
PROCESS_DRAFTS_ENABLED=false
