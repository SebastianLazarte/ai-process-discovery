# Copy to /opt/apd/.env on the server, owner apd, mode 600. Never commit the real file.

# Release of each service, without the leading v (image tags on ghcr.io). deploy.sh moves
# them and records them here (ADR 0016); they differ only during the 2.0.0 switch or after a
# partial rollback. release-please keeps this example at the latest release.
# x-release-please-start-version
APD_VERSION=1.5.0
APD_WEB_VERSION=1.5.0
# x-release-please-end

# Generate with: openssl rand -hex 24 (hex keeps the database URL valid)
POSTGRES_PASSWORD=

# Key from the dedicated demo workspace, which has a monthly spend limit (ADR 0008)
ANTHROPIC_API_KEY=
# The demo runs on the lowest-cost current model. Empty falls back to the default in
# app/core/config.py, a larger model at many times the price per analysis.
ANTHROPIC_MODEL=claude-haiku-5-5

# Analyses per UTC day that may call the LLM
LLM_DAILY_LIMIT=50
