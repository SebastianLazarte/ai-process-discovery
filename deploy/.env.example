# Copy to /opt/apd/.env on the server, owner deploy, mode 600. Never commit the real file.

# Release to run, without the leading v (an image tag on ghcr.io)
APD_VERSION=1.1.0

# Generate with: openssl rand -hex 24 (hex keeps the database URL valid)
POSTGRES_PASSWORD=

# Key from the dedicated demo workspace, which has a monthly spend limit (ADR 0008)
ANTHROPIC_API_KEY=
# Empty uses the default model from app/core/config.py
ANTHROPIC_MODEL=

# Analyses per UTC day that may call the LLM
LLM_DAILY_LIMIT=50
